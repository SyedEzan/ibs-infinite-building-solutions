{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://ibsolutions.pk/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.ibsolutions.pk"
        }
      ]
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ]
}
