# Brevo transactional email configuration for api/contact.js
# Copy this file to .env for local development and set the same values in
# Vercel -> Project Settings -> Environment Variables for production.
# NEVER commit real values — all .env files are git-ignored.

# Brevo API key (Brevo -> Settings -> SMTP & API -> API Keys). Server-only secret.
BREVO_API_KEY=

# Verified sender address on a domain you control in Brevo.
BREVO_FROM_EMAIL=

# Inbox that receives contact-form inquiries.
BREVO_TO_EMAIL=
